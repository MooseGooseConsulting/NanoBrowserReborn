{
  "manifest_version": 3,
  "name": "Nano Browser Userscript Runner POC",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["userScripts", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
